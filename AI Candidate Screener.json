            {
              "content": "=You are a senior HR screening expert. Evaluate candidates against job descriptions with precision and fairness.\n\nRespond ONLY with valid JSON. No markdown, no extra text, no explanation.\n\n{\n  \"match_score\": <integer 0-100>,\n  \"decision\": \"Shortlist\" or \"Reject\",\n  \"matching_skills\": [\"skill1\", \"skill2\"],\n  \"missing_skills\": [\"skill1\", \"skill2\"],\n  \"ai_summary\": \"2-3 sentence evaluation\",\n  \"score_breakdown\": {\n    \"skills_match\": <0-40>,\n    \"experience_match\": <0-30>,\n    \"education_match\": <0-20>,\n    \"overall_fit\": <0-10>\n  }\n}\n\nRules:\n- 75 to 100 = Shortlist\n- 0 to 74 = Reject\n- Be objective and consistent"
            },
            {
              "content": "=## JOB DESCRIPTION\n{{ $json.body.jobDescription }}\n\n## CANDIDATE PROFILE\nName: {{ $json[\"body.candidates\"].name }}\nEmail: {{ $json[\"body.candidates\"].email }}\nSkills: {{ $json[\"body.candidates\"].skills }}\nExperience: {{ $json[\"body.candidates\"].experience }}\nEducation: {{ $json[\"body.candidates\"].education }}\nCurrent Role: {{ $json[\"body.candidates\"].currentRole }}\n\nReturn ONLY the JSON."
            }
          ]
